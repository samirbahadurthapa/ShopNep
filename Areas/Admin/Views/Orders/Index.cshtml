@model List<Order>
@{
    ViewData["Title"] = "Manage Orders";
}

<h2>Orders</h2>

<div class="mb-3">
    <form method="get" class="d-flex gap-2">
        <select name="status" class="form-select" style="width:220px;" onchange="this.form.submit()">
            <option value="">All Statuses</option>
            @foreach (var s in Enum.GetValues<OrderStatus>())
            {
                <option value="@((int)s)" selected="@(ViewBag.SelectedStatus?.ToString() == s.ToString())">@s</option>
            }
        </select>
    </form>
</div>

<table class="table table-striped">
    <thead>
        <tr><th>Order #</th><th>Customer</th><th>Date</th><th>Total</th><th>Payment</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var o in Model)
        {
            <tr>
                <td>#@o.Id</td>
                <td>@o.User?.Email</td>
                <td>@o.OrderDate.ToLocalTime().ToString("MMM dd, yyyy")</td>
                <td>Rs. @o.TotalAmount.ToString("N2")</td>
                <td>@o.PaymentMethod</td>
                <td><span class="badge bg-info">@o.Status</span></td>
                <td><a asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-primary">View</a></td>
            </tr>
        }
    </tbody>
</table>
