@model Order
@{
    ViewData["Title"] = $"Order #{Model.Id}";
}

<h2>Order #@Model.Id</h2>
<p class="text-muted">Placed by @Model.User?.Email on @Model.OrderDate.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</p>

<div class="row">
    <div class="col-md-7">
        <table class="table">
            <thead><tr><th>Product</th><th>Price</th><th>Qty</th><th>Subtotal</th></tr></thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>Rs. @item.UnitPrice.ToString("N2")</td>
                        <td>@item.Quantity</td>
                        <td>Rs. @item.LineTotal.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-bold">
                    <td colspan="3" class="text-end">Total</td>
                    <td>Rs. @Model.TotalAmount.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="col-md-5">
        <div class="card mb-3">
            <div class="card-header fw-bold">Update Status</div>
            <div class="card-body">
                <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                    <select name="status" class="form-select">
                        @foreach (var s in Enum.GetValues<OrderStatus>())
                        {
                            <option value="@((int)s)" selected="@(s == Model.Status)">@s</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-primary">Update</button>
                </form>
                <p class="mt-2 mb-0">Payment: <strong>@Model.PaymentMethod</strong></p>
                @if (!string.IsNullOrEmpty(Model.GatewayReferenceId))
                {
                    <p class="mb-0">Gateway ref: <code>@Model.GatewayReferenceId</code></p>
                }
            </div>
        </div>

        @if (Model.Address != null)
        {
            <div class="card">
                <div class="card-header fw-bold">Delivery Address</div>
                <div class="card-body">
                    <p class="mb-1">@Model.Address.FullName — @Model.Address.Phone</p>
                    <p class="mb-0">@Model.Address.StreetAddress, @Model.Address.City @Model.Address.State @Model.Address.PostalCode, @Model.Address.Country</p>
                </div>
            </div>
        }
    </div>
</div>

<a asp-action="Index" class="btn btn-link mt-3">← Back to Orders</a>
