@model AddressFormViewModel
@{
    ViewData["Title"] = "Add Delivery Address";
}

<h2>Add Delivery Address</h2>

<form asp-action="AddAddress" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="StreetAddress" class="form-label"></label>
        <input asp-for="StreetAddress" class="form-control" />
        <span asp-validation-for="StreetAddress" class="text-danger"></span>
    </div>
    <div class="row">
        <div class="col mb-3">
            <label asp-for="City" class="form-label"></label>
            <input asp-for="City" class="form-control" />
            <span asp-validation-for="City" class="text-danger"></span>
        </div>
        <div class="col mb-3">
            <label asp-for="State" class="form-label"></label>
            <input asp-for="State" class="form-control" />
        </div>
    </div>
    <div class="row">
        <div class="col mb-3">
            <label asp-for="PostalCode" class="form-label"></label>
            <input asp-for="PostalCode" class="form-control" />
        </div>
        <div class="col mb-3">
            <label asp-for="Country" class="form-label"></label>
            <input asp-for="Country" class="form-control" />
        </div>
    </div>
    <div class="form-check mb-3">
        <input asp-for="IsDefault" class="form-check-input" />
        <label asp-for="IsDefault" class="form-check-label">Set as default address</label>
    </div>

    <button type="submit" class="btn btn-primary">Save Address</button>
    <a asp-action="Index" class="btn btn-link">Back to Checkout</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
