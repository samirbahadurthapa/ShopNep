@model ProductListViewModel
@{
    ViewData["Title"] = "Shop";
}

<div class="row">
    <div class="col-12">
        <section class="shop-hero">
            <div class="hero-copy">
                <p class="eyebrow">Made for your everyday</p>
                <h1>Good things,<br><em>close to home.</em></h1>
                <p class="hero-text">Discover useful, beautiful finds from brands and makers you can feel good about
                    supporting.</p>
                    <a class="btn btn-dark hero-action" href="#collection">Explore the collection <span
                        aria-hidden="true">→</span></a>
                    </div>
                    <div class="hero-stamp" aria-hidden="true"><span>CURATED<br>IN NEPAL</span></div>
                </div>
            </div>
        </div>

        <div class="collection-layout" id="collection">
            <aside class="category-rail ps-4 fs-5">
                <div class="section-kicker">Browse by</div>
                <a class="category-link @(Model.SelectedCategoryId == null ? "selected" : "")" asp-action="Index">All products
                    <span>↗</span></a>
                    @foreach (var cat in Model.Categories)
                    {
                        <a class="category-link @(Model.SelectedCategoryId == cat.Id ? "selected" : "")" asp-action="Index"
                           asp-route-categoryId="@cat.Id">@cat.Name <span>↗</span></a>
                    }
                </aside>

                <section class="catalog-column">
                    <div class="catalog-heading">
                        <div>
                            <p class="eyebrow">The edit</p>
                            <h2>@(Model.SelectedCategoryId.HasValue ? "Selected for you" : "Fresh arrivals")</h2>
                        </div>
                        <span class="product-count">@Model.Products.Count product@(Model.Products.Count == 1 ? "" : "s")</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                    {
                        <p class="search-result">Showing results for <strong>"@Model.SearchTerm"</strong></p>
                    }

                    @if (!Model.Products.Any())
                    {
                        <div class="alert alert-warning">No products found.</div>
                    }
                    else
                    {
                        <div class="product-grid">
                            @foreach (var product in Model.Products)
                            {
                                <article class="product-card">
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="product-image-wrap">
                                        <img src="@(product.ImageUrl ?? "/images/placeholder.png")" alt="@product.Name" />
                                        <span class="quick-view">View piece <span aria-hidden="true">↗</span></span>
                                    </a>
                                    <div class="product-info">
                                        <p class="product-category">@product.Category?.Name</p>
                                        <h3><a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">@product.Name</a>
                                        </h3>
                                        <p class="product-price">Rs. @product.Price.ToString("N2")</p>
                                    </div>
                                </article>
                            }
                        </div>

                        @if (Model.TotalPages > 1)
                        {
                            <nav class="catalog-pagination">
                                <ul class="pagination">
                                    @for (int i = 1; i <= Model.TotalPages; i++)
                                    {
                                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                            <a class="page-link" asp-action="Index" asp-route-page="@i"
                                               asp-route-categoryId="@Model.SelectedCategoryId" asp-route-search="@Model.SearchTerm">@i</a>
                                        </li>
                                    }
                                </ul>
                            </nav>
                        }
                    }
                </section>
            </div>
