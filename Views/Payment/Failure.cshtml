@model Order?
@{
    ViewData["Title"] = "Payment Failed";
    var reason = ViewBag.Reason as string;
}

<div class="text-center py-5">
    <div style="font-size:4rem;">❌</div>
    <h2 class="text-danger">Payment Failed</h2>
    @if (Model != null)
    {
        <p>Your order <strong>#@Model.Id</strong> could not be paid for. The stock has been released back to inventory.</p>
    }
    @if (!string.IsNullOrEmpty(reason))
    {
        <p class="text-muted">Reason: @reason</p>
    }
    <div class="mt-3">
        <a asp-controller="Cart" asp-action="Index" class="btn btn-primary">Back to Cart</a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-link">Continue Shopping</a>
    </div>
</div>
